@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix bufsz: <http://lv2plug.in/ns/ext/buf-size#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rsz:   <http://lv2plug.in/ns/ext/resize-port#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .

# Each plugin but the last two breaks one rule the loader refuses it by.  The
# binaries are empty: nothing here is ever opened.

<http://example.com/lv2/fix-b/untyped>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Untyped" ;
    lv2:binary <refused.so>, <refused.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:InputPort ;
          lv2:index 2 ;
          lv2:symbol "mystery" ;
          lv2:name "Mystery" ] .

<http://example.com/lv2/fix-b/no-index>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "No Index" ;
    lv2:binary <refused.so>, <refused.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:symbol "gain" ;
          lv2:name "Gain" ] .

<http://example.com/lv2/fix-b/bad-index>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Bad Index" ;
    lv2:binary <refused.so>, <refused.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index -1 ;
          lv2:symbol "gain" ;
          lv2:name "Gain" ] .

<http://example.com/lv2/fix-b/duplicate-index>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Duplicate Index" ;
    lv2:binary <refused.so>, <refused.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 1 ;
          lv2:symbol "gain" ;
          lv2:name "Gain" ] .

<http://example.com/lv2/fix-b/both-directions>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Both Directions" ;
    lv2:binary <refused.so>, <refused.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:InputPort, lv2:OutputPort, lv2:ControlPort ;
          lv2:index 2 ;
          lv2:symbol "gain" ;
          lv2:name "Gain" ] .

<http://example.com/lv2/fix-b/no-direction>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "No Direction" ;
    lv2:binary <refused.so>, <refused.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:ControlPort ;
          lv2:index 2 ;
          lv2:symbol "gain" ;
          lv2:name "Gain" ] .

<http://example.com/lv2/fix-b/unreadable-bound>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Unreadable Bound" ;
    lv2:binary <refused.so>, <refused.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 2 ;
          lv2:symbol "gain" ;
          lv2:name "Gain" ;
          lv2:minimum "low" ] .

<http://example.com/lv2/fix-b/nonfinite-bound>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Non-finite Bound" ;
    lv2:binary <refused.so>, <refused.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 2 ;
          lv2:symbol "gain" ;
          lv2:name "Gain" ;
          lv2:maximum "inf" ] .

<http://example.com/lv2/fix-b/unreadable-minimum-size>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Unreadable Minimum Size" ;
    lv2:binary <refused.so>, <refused.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:InputPort, atom:AtomPort ;
          atom:bufferType atom:Sequence ;
          lv2:index 2 ;
          lv2:symbol "events" ;
          lv2:name "Events" ;
          rsz:minimumSize "large" ] .

<http://example.com/lv2/fix-b/huge-minimum-size>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Huge Minimum Size" ;
    lv2:binary <refused.so>, <refused.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:InputPort, atom:AtomPort ;
          atom:bufferType atom:Sequence ;
          lv2:index 2 ;
          lv2:symbol "events" ;
          lv2:name "Events" ;
          rsz:minimumSize 4294967296 ] .

<http://example.com/lv2/fix-b/chunk-port>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Chunk Port" ;
    lv2:binary <refused.so>, <refused.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:InputPort, atom:AtomPort ;
          atom:bufferType atom:Chunk ;
          lv2:index 2 ;
          lv2:symbol "blob" ;
          lv2:name "Blob" ] .

<http://example.com/lv2/fix-b/required-default>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Required Default" ;
    lv2:binary <refused.so>, <refused.dll> ;
    lv2:requiredFeature state:loadDefaultState ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ] .

# Two plugin-level reasons and a broken port: all three are named.
<http://example.com/lv2/fix-b/three-reasons>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Three Reasons" ;
    lv2:binary <refused.so>, <refused.dll> ;
    lv2:requiredFeature bufsz:fixedBlockLength, state:loadDefaultState ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:symbol "gain" ;
          lv2:name "Gain" ] .

# Accepted: a sample-rate bound far past a float stays in a float's range at
# every rate instead of overflowing.
<http://example.com/lv2/fix-b/scaled-bound>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Scaled Bound" ;
    lv2:binary <refused.so>, <refused.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 2 ;
          lv2:symbol "freq" ;
          lv2:name "Frequency" ;
          lv2:portProperty lv2:sampleRate ;
          lv2:minimum 0.0 ;
          lv2:maximum 1.0e300 ;
          lv2:default 1.0e300 ] .
