@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .

<http://example.com/lv2/keyed>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Keyed Effect" ;
    lv2:binary <keyed.so>, <keyed.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "key" ;
          lv2:name "Key" ;
          lv2:portProperty lv2:isSideChain, lv2:connectionOptional ],
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 2 ;
          lv2:symbol "key_out" ;
          lv2:name "Key Out" ;
          lv2:portProperty lv2:isSideChain, lv2:connectionOptional ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 3 ;
          lv2:symbol "out" ;
          lv2:name "Out" ] .

<http://example.com/lv2/key-only>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Key Only" ;
    lv2:binary <keyed.so>, <keyed.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "key" ;
          lv2:name "Key" ;
          lv2:portProperty lv2:isSideChain ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ] .
