@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .

<http://example.com/lv2/swapped>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Swapped" ;
    lv2:binary <bounds.so>, <bounds.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 2 ;
          lv2:symbol "bounded" ;
          lv2:name "Bounded" ;
          lv2:minimum 10 ;
          lv2:maximum 0 ;
          lv2:default 20 ] .

<http://example.com/lv2/nonfinite>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Non-finite" ;
    lv2:binary <bounds.so>, <bounds.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 2 ;
          lv2:symbol "jitter" ;
          lv2:name "Jitter" ;
          lv2:minimum 0 ;
          lv2:maximum "inf" ;
          lv2:default "NaN" ] .
