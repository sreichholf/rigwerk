@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .

<http://example.com/lv2/cv>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "CV Effect" ;
    lv2:binary <cv.so>, <cv.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:InputPort, lv2:CVPort ;
          lv2:index 2 ;
          lv2:symbol "vibrato" ;
          lv2:name "Vibrato" ] .
