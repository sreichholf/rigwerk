@prefix atom:    <http://lv2plug.in/ns/ext/atom#> .
@prefix bufsize: <http://lv2plug.in/ns/ext/buf-size#> .
@prefix doap:    <http://usefulinc.com/ns/doap#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix lv2:     <http://lv2plug.in/ns/lv2core#> .
@prefix opts:    <http://lv2plug.in/ns/ext/options#> .
@prefix urid:    <http://lv2plug.in/ns/ext/urid#> .

<http://example.com/lv2/example>
    a lv2:Plugin, lv2:EffectPlugin, lv2:AmplifierPlugin ;
    doap:name "Example Amp" ;
    doap:maintainer <http://example.com/people/jane> ;
    lv2:binary <example.so>, <example.dll> ;
    lv2:requiredFeature urid:map, opts:options, bufsize:boundedBlockLength ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in_l" ;
          lv2:name "Left In" ],
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "in_r" ;
          lv2:name "Right In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 2 ;
          lv2:symbol "out_l" ;
          lv2:name "Left Out" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 3 ;
          lv2:symbol "out_r" ;
          lv2:name "Right Out" ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 4 ;
          lv2:symbol "gain" ;
          lv2:name "Gain" ],
        [ a lv2:InputPort, atom:AtomPort ;
          lv2:index 5 ;
          lv2:symbol "events" ;
          lv2:name "Events" ] .

<http://example.com/people/jane>
    foaf:name "Jane Doe" .

<http://example.com/lv2/tone>
    a lv2:Plugin, lv2:FilterPlugin ;
    doap:name "Tone" ;
    doap:maintainer <http://example.com/people/john> ;
    lv2:binary <example.so>, <example.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:OutputPort, lv2:ControlPort ;
          lv2:index 2 ;
          lv2:symbol "reduction" ;
          lv2:name "Reduction" ] .

<http://example.com/lv2/synth>
    a lv2:Plugin, lv2:InstrumentPlugin ;
    doap:name "Synth" ;
    lv2:binary <example.so>, <example.dll> ;
    lv2:port
        [ a lv2:InputPort, atom:AtomPort ;
          lv2:index 0 ;
          lv2:symbol "midi" ;
          lv2:name "MIDI In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ] .
