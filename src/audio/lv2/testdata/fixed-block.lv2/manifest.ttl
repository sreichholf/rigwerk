@prefix bufsize: <http://lv2plug.in/ns/ext/buf-size#> .
@prefix doap:    <http://usefulinc.com/ns/doap#> .
@prefix lv2:     <http://lv2plug.in/ns/lv2core#> .
@prefix urid:    <http://lv2plug.in/ns/ext/urid#> .

<http://example.com/lv2/fixed>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Fixed Block" ;
    lv2:binary <fixed.so>, <fixed.dll> ;
    lv2:requiredFeature urid:map, bufsize:fixedBlockLength ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ] .
