@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .

# The foreign binary is named first, so taking only the first lv2:binary
# would drop each plugin on one of the two platforms.
<http://example.com/lv2/dll-first>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "DLL First" ;
    lv2:binary <dll-first.dll>, <dll-first.so> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ] .

<http://example.com/lv2/so-first>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "SO First" ;
    lv2:binary <so-first.so>, <so-first.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "out" ;
          lv2:name "Out" ] .
