@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix eg:    <http://example.com/lv2/default-state#> .

<http://example.com/lv2/default-state>
    a lv2:Plugin ;
    lv2:binary <default.so> ;
    lv2:optionalFeature state:loadDefaultState ;
    state:state [
        eg:sample <click.wav> ;
        eg:gain "0.5"^^xsd:float ;
        eg:count 3 ;
        eg:name "hello" ;
        eg:mode eg:fast ;
        eg:on true ;
        eg:nested [ eg:x 1 ]
    ] .

<http://example.com/lv2/no-default>
    a lv2:Plugin ;
    lv2:binary <default.so> ;
    state:state [ eg:gain "1.0"^^xsd:float ] .
