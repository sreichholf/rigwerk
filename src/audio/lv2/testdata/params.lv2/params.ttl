@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<http://example.com/lv2/params>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Params" ;
    lv2:binary <params.so>, <params.dll> ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/urid#map>,
                        <http://lv2plug.in/ns/ext/buf-size#boundedBlockLength> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in_l" ;
          lv2:name "Left In" ],
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 1 ;
          lv2:symbol "in_r" ;
          lv2:name "Right In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 2 ;
          lv2:symbol "out_l" ;
          lv2:name "Left Out" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 3 ;
          lv2:symbol "out_r" ;
          lv2:name "Right Out" ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 4 ;
          lv2:symbol "gain" ;
          lv2:name "Gain" ;
          lv2:default 1.0 ;
          lv2:minimum 0.0 ;
          lv2:maximum 10.0 ;
          units:unit units:db ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 5 ;
          lv2:symbol "cutoff" ;
          lv2:name "Cutoff" ;
          lv2:default 1000.0 ;
          lv2:minimum 20.0 ;
          lv2:maximum 20000.0 ;
          lv2:portProperty pprops:logarithmic ;
          units:unit units:hz ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 6 ;
          lv2:symbol "rate_scale" ;
          lv2:name "Rate Scale" ;
          lv2:default 1.0 ;
          lv2:minimum 0.1 ;
          lv2:maximum 10.0 ;
          lv2:portProperty lv2:sampleRate ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 7 ;
          lv2:symbol "mode" ;
          lv2:name "Mode" ;
          lv2:default 0 ;
          lv2:minimum 0 ;
          lv2:maximum 3 ;
          lv2:portProperty lv2:integer, lv2:enumeration ;
          lv2:scalePoint [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 0 ;
                           <http://www.w3.org/2000/01/rdf-schema#label> "Off" ],
                        [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 1 ;
                          <http://www.w3.org/2000/01/rdf-schema#label> "A" ],
                        [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 2 ;
                          <http://www.w3.org/2000/01/rdf-schema#label> "B" ],
                        [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> 3 ;
                          <http://www.w3.org/2000/01/rdf-schema#label> "C" ] ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 8 ;
          lv2:symbol "on" ;
          lv2:name "On" ;
          lv2:default 0 ;
          lv2:minimum 0 ;
          lv2:maximum 1 ;
          lv2:portProperty lv2:toggled ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 9 ;
          lv2:symbol "hidden" ;
          lv2:name "Hidden" ;
          lv2:default 1 ;
          lv2:minimum 0 ;
          lv2:maximum 1 ;
          lv2:portProperty pprops:notOnGUI ],
        [ a lv2:OutputPort, lv2:ControlPort ;
          lv2:index 10 ;
          lv2:symbol "level" ;
          lv2:name "Level" ;
          lv2:default 0 ;
          lv2:minimum 0 ;
          lv2:maximum 1 ],
        [ a lv2:OutputPort, lv2:ControlPort ;
          lv2:index 11 ;
          lv2:symbol "latency" ;
          lv2:name "Latency" ;
          lv2:default 0 ;
          lv2:minimum 0 ;
          lv2:maximum 1000 ;
          lv2:designation lv2:latency ;
          lv2:portProperty lv2:reportsLatency ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 12 ;
          lv2:symbol "gain" ;
          lv2:name "Gain Copy" ;
          lv2:default 0 ;
          lv2:minimum 0 ;
          lv2:maximum 1 ],
        [ a lv2:InputPort, atom:AtomPort ;
          lv2:index 13 ;
          lv2:symbol "events_in" ;
          lv2:name "Events In" ;
          atom:bufferType atom:Sequence ],
        [ a lv2:OutputPort, atom:AtomPort ;
          lv2:index 14 ;
          lv2:symbol "events_out" ;
          lv2:name "Events Out" ;
          atom:bufferType atom:Sequence ;
          <http://lv2plug.in/ns/ext/resize-port#minimumSize> 32768 ],
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 15 ;
          lv2:symbol "sidechain" ;
          lv2:name "Sidechain" ;
          lv2:portProperty lv2:connectionOptional ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 16 ;
          lv2:symbol "voices" ;
          lv2:name "Voices" ;
          lv2:default 4 ;
          lv2:minimum 1 ;
          lv2:maximum 8 ;
          lv2:portProperty lv2:integer ],
        [ a lv2:InputPort, lv2:CVPort ;
          lv2:index 17 ;
          lv2:symbol "vibrato" ;
          lv2:name "Vibrato" ;
          lv2:portProperty lv2:connectionOptional ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 18 ;
          lv2:symbol "mix" ;
          lv2:name "Mix" ;
          lv2:default 50 ;
          lv2:minimum 0 ;
          lv2:maximum 100 ;
          units:unit units:pc ] .
