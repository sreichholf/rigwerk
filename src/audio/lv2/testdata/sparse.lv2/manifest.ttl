@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .

<http://example.com/lv2/sparse>
    a lv2:Plugin, lv2:EffectPlugin ;
    doap:name "Sparse" ;
    lv2:binary <sparse.so>, <sparse.dll> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ;
          lv2:index 0 ;
          lv2:symbol "in" ;
          lv2:name "In" ],
        [ a lv2:OutputPort, lv2:AudioPort ;
          lv2:index 2 ;
          lv2:symbol "out" ;
          lv2:name "Out" ],
        [ a lv2:InputPort, lv2:ControlPort ;
          lv2:index 3 ;
          lv2:symbol "tone" ;
          lv2:name "Tone" ;
          lv2:minimum 0 ;
          lv2:maximum 1 ;
          lv2:default 0.5 ] .
